# Copy to `.env` at the root of the project and fill in the keys.
#
# It is read once, when the server starts; a variable already set in the
# environment is left alone, so a deployment can pass its own secrets and
# ignore this file entirely.
#
# Only secrets belong here. Everything else the service can be told —
# paths, models, chunk length, the address it listens on — lives in
# `sentry.yml`; see `sentry.example.yml`, which names the environment
# variable of each setting for a deployment that would rather pass it that
# way. A variable always wins over the file.

# Google Gemini: transcription, diarization, and the summary written from
# the transcript. This is the only key the pipeline needs.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Where to read the configuration file from, when it is not the
# `sentry.yml` at the root of the project.
# SENTRY_CONFIG_FILE=/etc/sentry/config.yml
