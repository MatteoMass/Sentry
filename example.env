# Copy to `.env` at the root of the project and fill in the keys.
#
# It is read once, when the server starts; a variable already set in the
# environment is left alone, so a deployment can pass its own secrets and
# ignore this file entirely.

# Google Gemini: transcription, diarization, and the summary written from
# the transcript. This is the only key the pipeline needs.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Language the recordings are expected to be in, as a BCP-47 tag.
# It is a hint: the transcript records whatever language is actually spoken.
# Default: it-IT
# SENTRY_TRANSCRIPTION_LANGUAGE=it-IT

# Optional. How long each piece of audio sent to the model lasts, in minutes.
# Shorter pieces answer faster and time out less; longer ones leave fewer
# seams where a voice could be given a new number.
# Default: 5
# SENTRY_TRANSCRIPTION_CHUNK_MINUTES=5

# Optional. Model that does the listening.
# Default: gemini-3.7-flash
# SENTRY_TRANSCRIPTION_MODEL=gemini-3.7-flash
